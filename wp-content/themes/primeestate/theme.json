{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink (primary text/CTA)", "color": "#0F172A" },
        { "slug": "ink-soft", "name": "Ink Soft (secondary text)", "color": "#475569" },
        { "slug": "gold", "name": "Gold (premium accent)", "color": "#B08D57" },
        { "slug": "gold-soft", "name": "Gold Soft (accent tint)", "color": "#EFE6D8" },
        { "slug": "surface", "name": "Surface (page background)", "color": "#FFFFFF" },
        { "slug": "surface-muted", "name": "Surface Muted (section background)", "color": "#F8F7F4" },
        { "slug": "border", "name": "Border", "color": "#E2E2DE" },
        { "slug": "success", "name": "Success", "color": "#1E7A4C" },
        { "slug": "error", "name": "Error", "color": "#B3261E" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans (body)",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "display",
          "name": "Display (headings)",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "Extra Small", "size": "0.75rem" },
        { "slug": "sm", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1rem" },
        { "slug": "md", "name": "Medium", "size": "1.125rem" },
        { "slug": "lg", "name": "Large", "size": "1.375rem" },
        { "slug": "xl", "name": "Extra Large", "size": "1.75rem" },
        { "slug": "2xl", "name": "2X Large", "size": "2.25rem" },
        { "slug": "3xl", "name": "3X Large", "size": "3rem" }
      ],
      "lineHeight": true
    },
    "spacing": {
      "customSpacingSize": false,
      "units": [ "px", "rem", "%", "vh" ],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        { "slug": "xs", "name": "Extra Small", "size": "0.5rem" },
        { "slug": "sm", "name": "Small", "size": "1rem" },
        { "slug": "md", "name": "Medium", "size": "1.5rem" },
        { "slug": "lg", "name": "Large", "size": "2.5rem" },
        { "slug": "xl", "name": "Extra Large", "size": "4rem" },
        { "slug": "2xl", "name": "2X Large", "size": "6rem" }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "width": true
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--gold)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "text": "var(--wp--preset--color--surface)",
          "background": "var(--wp--preset--color--ink)"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--gold)"
          }
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)"
        }
      }
    }
  },
  "customTemplates": [],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
